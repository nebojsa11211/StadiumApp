@* Line-icon set in the tab-bar idiom: 24px grid, round 1.7 stroke, currentColor. Replaces emoji,
   which render differently per OS, ignore text colour and look toy-like next to Inter. Always
   decorative — the adjacent text carries the meaning, so aria-hidden is fixed. *@
<svg class="runner-ico @Class" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "check":        <path d="M5 12.5l4.5 4.5L19 7.5" /> break;
        case "check-circle": <circle cx="12" cy="12" r="8.5" /><path d="M8.2 12.3l2.7 2.7 5-5.4" /> break;
        case "return":       <path d="M9 14.5L4.5 10 9 5.5" /><path d="M4.5 10H15a4.5 4.5 0 0 1 0 9h-3.5" /> break;
        case "clock":        <circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /> break;
        case "alert":        <path d="M12 4l8.8 15.5H3.2z" /><path d="M12 10v4" /><path d="M12 16.9v.1" /> break;
        case "lock":         <rect x="5" y="10.5" width="14" height="10" rx="2" /><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" /> break;
        case "unlock":       <rect x="5" y="10.5" width="14" height="10" rx="2" /><path d="M8.5 10.5V8a3.5 3.5 0 0 1 6.8-1.2" /> break;
        case "bag":          <path d="M5.5 8h13l-1 12.5h-11z" /><path d="M9 10.5V7a3 3 0 0 1 6 0v3.5" /> break;
        case "camera":       <path d="M4 8h3l1.6-2.2h6.8L17 8h3v11H4z" /><circle cx="12" cy="13.2" r="3.4" /> break;
        case "ticket":       <path d="M3 6.5h18v3a2.5 2.5 0 0 0 0 5v3H3v-3a2.5 2.5 0 0 0 0-5z" /><path d="M14.5 7v1.5M14.5 11.2v1.6M14.5 15.5V17" /> break;
        case "refresh":      <path d="M19 12a7 7 0 1 1-2.05-4.95" /><path d="M17.5 3.5v4h-4" /> break;
        case "clipboard":    <rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 2.8h6v2.6H9zM8.5 10h7M8.5 13.5h7M8.5 17h4.5" /> break;
        case "chevron":      <path d="M9.5 6l6 6-6 6" /> break;
        case "slash":        <circle cx="12" cy="12" r="8.5" /><path d="M6 6l12 12" /> break;
        case "scan":         <path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16" /><path d="M7.5 12h9" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
}
