@page "/"
@implements IAsyncDisposable
@inject RunnerApiService Api
@inject OutboxService Outbox
@inject RunnerLiveService Live
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> Localizer

<BrandPageTitle Station="@Localizer["Layout_Brand"]" Title="@Localizer["Home_PageTitle"]" />

<div class="runner-page @(selected.Count > 0 ? "runner-page-has-bar" : "")" id="runner-home-page">
    <div class="runner-page-head" id="runner-home-page-head">
        <h1 class="runner-page-title" id="runner-home-title">@Localizer["Home_ReadyForPickup"]</h1>
        <div class="runner-head-actions" id="runner-home-head-actions">
            <button class="runner-refresh @(scannerActive ? "runner-refresh-on" : "")" @onclick="ToggleScanner"
                    aria-label="@Localizer["Home_ScanSlips"]" aria-pressed="@scannerActive" id="runner-pool-scan-btn"><svg class="runner-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.6-2.2h6.8L17 8h3v11H4z"/><circle cx="12" cy="13.2" r="3.4"/></svg></button>
            <button class="runner-refresh" @onclick="Load" aria-label="@Localizer["Home_Refresh"]" id="runner-pool-refresh"><svg class="runner-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12a7 7 0 1 1-2.05-4.95"/><path d="M17.5 3.5v4h-4"/></svg></button>
        </div>
    </div>

    @* Slip scanner: stays live while the runner sweeps a stack of pickup slips at the bar, adding
       each one to the same selection the cards below feed. Deliberately does NOT claim on scan —
       claiming stays a single deliberate tap on Collect, so a stray decode can't take an order. *@
    @if (scannerActive)
    {
        <div class="runner-scan-camera" id="runner-pool-camera">
            <div class="runner-scan-viewfinder">
                <video id="@ScannerVideoId" playsinline muted class="runner-scan-video"></video>
                <span class="runner-scan-frame" aria-hidden="true"></span>
            </div>
            <p class="runner-scan-hint" id="runner-pool-scan-hint">@Localizer["Home_ScanHint"]</p>
            @if (scanFeed.Count > 0)
            {
                <ul class="runner-scan-feed" id="runner-pool-scan-feed" aria-live="polite">
                    @foreach (var entry in scanFeed)
                    {
                        <li class="runner-scan-feed-item runner-scan-feed-@entry.Kind">@entry.Text</li>
                    }
                </ul>
            }
            <button class="runner-cta runner-cta-secondary" @onclick="StopScannerAsync" id="runner-pool-scan-stop">
                @Localizer["Home_StopScan"]
            </button>
        </div>
    }

    @if (scannerUnsupported)
    {
        <div class="runner-notice runner-notice-info" id="runner-pool-scan-unsupported">@Localizer["Home_ScanNotSupported"]</div>
    }
    @if (!string.IsNullOrEmpty(scannerError))
    {
        <div class="runner-notice runner-notice-info" id="runner-pool-scan-error">@Localizer["Home_ScanError"]</div>
    }

    @if (!Outbox.IsOnline)
    {
        <div class="runner-offline-banner" role="status" id="runner-pool-offline">
            <RunnerIcon Name="alert" Class="runner-banner-icon" />
            <span>@Localizer["Home_OfflineBanner"]</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="runner-notice runner-notice-info" role="status" aria-live="polite" id="runner-pool-message">@message</div>
    }

    @if (loading && orders is null)
    {
        <div class="runner-loading" id="runner-home-loading"><div class="runner-cta-spinner" id="runner-home-spinner"></div></div>
    }
    else if (orders is null || orders.Count == 0)
    {
        <div class="runner-empty" id="runner-home-empty">
            <div class="runner-empty-icon" id="runner-home-empty-icon" aria-hidden="true"><RunnerIcon Name="clipboard" /></div>
            <div class="runner-empty-title">@Localizer["Home_EmptyTitle"]</div>
            <div class="runner-empty-text" id="runner-home-empty-text">@Localizer["Home_NoOrdersEmpty"]</div>
        </div>
    }
    else
    {
        <div class="runner-pool-toolbar" id="runner-pool-toolbar">
            <span class="runner-pool-hint">@Localizer["Home_SelectHint"]</span>
            <button class="runner-linkbtn" @onclick="ToggleSelectAll" id="runner-pool-select-all"
                    disabled="@(!Outbox.IsOnline)">
                @(AllSelected ? Localizer["Home_ClearSelection"] : Localizer["Home_SelectAll"])
            </button>
        </div>

        @foreach (var o in orders)
        {
            var isSelected = selected.Contains(o.Id);
            @* Blazor drops a bare boolean `true` from aria-pressed, so pass the explicit string. *@
            <div class="runner-card runner-card-selectable @(isSelected ? "runner-card-selected" : "")"
                 role="button" aria-pressed="@(isSelected ? "true" : "false")" tabindex="0"
                 @onclick="() => ToggleSelect(o.Id)"
                 id="runner-pool-card-@o.Id">
                @* Top row: wait-time pill (the only thing that changes urgency) left; order ref + the
                   selection tick right, where a thumb-holding hand already looks for a checkbox. *@
                <div class="runner-card-top" id="@($"runner-pool-card-{o.Id}-top")">
                    <AgePill CreatedAt="@o.CreatedAt" Label="@Localizer["Home_Ready"]" />
                    <span class="runner-card-meta">
                        <span class="runner-order-id">#@o.Id</span>
                        <span class="runner-check @(isSelected ? "runner-check-on" : "")" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9"/></svg>
                        </span>
                    </span>
                </div>
                <SeatHero SeatPath="@o.SeatPath" SeatNumber="@o.SeatNumber" Id="@($"runner-pool-card-{o.Id}-seat")" />
                <div class="runner-items" id="@($"runner-pool-card-{o.Id}-items")">
                    @foreach (var it in o.OrderItems)
                    {
                        <div id="@($"runner-pool-card-{o.Id}-item-{o.OrderItems.IndexOf(it)}")"><span class="runner-qty">@it.Quantity×</span> @it.DrinkName <svg class="runner-cup" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h10l-1.4 17H8.4z"/><path d="M7.4 8h9.2"/></svg></div>
                    }
                </div>
                <div class="runner-total" id="runner-pool-total-@o.Id">
                    <span class="runner-total-label">@Localizer["Home_TotalLabel"]</span>
                    <span class="runner-total-amount">€@o.TotalAmount.ToString("F2")</span>
                </div>
            </div>
        }
    }
</div>

@if (selected.Count > 0)
{
    <div class="runner-actionbar" id="runner-pool-actionbar">
        <button class="runner-cta @(collecting ? "is-loading" : "")" @onclick="CollectSelected"
                disabled="@(collecting || !Outbox.IsOnline)"
                aria-busy="@collecting" id="runner-pool-collect">
            @if (collecting)
            {
                <span class="runner-cta-spinner" aria-hidden="true"></span>
                <span>@Localizer["Home_Collecting"]</span>
            }
            else if (!Outbox.IsOnline)
            {
                <RunnerIcon Name="lock" Class="runner-cta-icon" />
                <span>@Localizer["Home_OfflineClaim"]</span>
            }
            else
            {
                <RunnerIcon Name="bag" Class="runner-cta-icon" />
                <span>@Localizer["Home_CollectSelected", selected.Count]</span>
            }
        </button>
    </div>
}

@code {
    private List<OrderDto>? orders;
    private HashSet<int> selected = new();
    private bool loading;
    private bool collecting;
    private string? message;
    private System.Threading.Timer? timer;

    // Slip scanner state. The camera stays live across decodes (continuous mode) so a stack of
    // slips can be swept in one pass; each decode lands in `selected` alongside tapped cards.
    private bool scannerActive;
    private bool pendingScannerStart;
    private bool scannerUnsupported;
    private string? scannerError;
    private DotNetObjectReference<Home>? selfRef;
    private const string ScannerVideoId = "runner-pool-scan-video";

    // Rolling log of the last few scans, newest first. Eyes are on the slips, not the screen, so
    // this is the record a runner checks after a sweep to see what actually registered.
    private readonly List<ScanFeedItem> scanFeed = new();
    private const int ScanFeedLimit = 4;
    private sealed record ScanFeedItem(string Text, string Kind);

    private bool AllSelected => orders is { Count: > 0 } && selected.Count == orders.Count;

    protected override async Task OnInitializedAsync()
    {
        Outbox.OnChange += OnConnectivityChanged;
        Live.Changed += OnLiveChanged;
        await Load();
        _ = Live.EnsureStartedAsync();
        // Backstop poll: pushes (Live) refresh the pool instantly; this covers a phone that's offline
        // or mid-reconnect and so isn't receiving them.
        timer = new System.Threading.Timer(async _ => await InvokeAsync(Load), null,
            TimeSpan.FromSeconds(PollSeconds), TimeSpan.FromSeconds(PollSeconds));
    }

    private const int PollSeconds = 10;

    private void OnLiveChanged() => _ = InvokeAsync(Load);

    // Set when a refresh is requested mid-load, so exactly one more load follows instead of the later
    // request being dropped (or loads overlapping) during a burst of pushes.
    private bool reloadPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The <video> element only exists after the render that flips scannerActive on, so start the
        // camera here (post-render) to guarantee the element is in the DOM.
        if (pendingScannerStart)
        {
            pendingScannerStart = false;
            await StartScannerAsync();
        }
    }

    private void OnConnectivityChanged() => InvokeAsync(StateHasChanged);

    private async Task Load()
    {
        if (loading)
        {
            reloadPending = true;
            return;
        }
        loading = true;
        // A failed fetch (offline) keeps the last good pool on screen rather than blanking it.
        orders = await Api.GetPoolAsync() ?? orders;
        // Drop any selection that's no longer in the pool (claimed by another runner, delivered, etc.)
        // so the action-bar count and batch request never reference stale orders.
        if (orders is not null)
        {
            var live = orders.Select(o => o.Id).ToHashSet();
            selected.RemoveWhere(id => !live.Contains(id));
        }
        loading = false;
        StateHasChanged();

        if (reloadPending)
        {
            reloadPending = false;
            await Load();
        }
    }

    private void ToggleSelect(int orderId)
    {
        if (!selected.Remove(orderId))
            selected.Add(orderId);
        message = null;
        _ = Haptic();
    }

    private void ToggleSelectAll()
    {
        if (orders is null) return;
        if (AllSelected)
            selected.Clear();
        else
            selected = orders.Select(o => o.Id).ToHashSet();
        message = null;
    }

    // ---------------- Slip scanner ----------------

    private async Task ToggleScanner()
    {
        if (scannerActive || pendingScannerStart)
        {
            await StopScannerAsync();
            return;
        }

        scannerUnsupported = false;
        scannerError = null;
        message = null;
        scanFeed.Clear();
        scannerActive = true;       // renders the <video> element
        pendingScannerStart = true; // OnAfterRenderAsync starts the camera once it's in the DOM
    }

    private async Task StartScannerAsync()
    {
        selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            // The trailing `true` selects continuous mode: the camera stays live and reports every
            // distinct slip, instead of releasing after the first decode like the ticket scanner.
            var res = await JS.InvokeAsync<ScanStartResult>("runnerTicketScanner.start", ScannerVideoId, selfRef, true);
            if (res == null || !res.Supported)
            {
                scannerUnsupported = true;
                scannerActive = false;
            }
            else if (!res.Started)
            {
                scannerError = res.Error;
                scannerActive = false;
            }
        }
        catch (Exception ex)
        {
            scannerError = ex.Message;
            scannerActive = false;
        }
        StateHasChanged();
    }

    private async Task StopScannerAsync()
    {
        pendingScannerStart = false;
        if (!scannerActive)
            return;
        scannerActive = false;
        try { await JS.InvokeVoidAsync("runnerTicketScanner.stop"); }
        catch (Exception ex) { Console.WriteLine($"Stopping scanner failed: {ex.Message}"); }
    }

    /// <summary>
    /// A slip decoded by the camera. Adds the order to the current selection; claiming still
    /// requires the explicit Collect tap. Anything that isn't an order slip currently in the pool is
    /// reported in the feed rather than silently dropped — a runner holding a tray needs to know the
    /// difference between "added" and "nothing happened".
    /// </summary>
    [JSInvokable]
    public Task OnQrDecoded(string text) => InvokeAsync(async () =>
    {
        if (!OrderSlipCode.TryParse(text, out var orderId))
        {
            // Most likely a ticket QR (a customer deep link) rather than a pickup slip.
            PushFeed(Localizer["Home_ScanNotASlip"].Value, "miss");
        }
        else if (orders is null || orders.All(o => o.Id != orderId))
        {
            // Prepared but already claimed by another runner, already delivered, or filtered out of
            // this runner's pool — either way it isn't theirs to take.
            PushFeed(Localizer["Home_ScanNotInPool", orderId].Value, "miss");
        }
        else if (!selected.Add(orderId))
        {
            PushFeed(Localizer["Home_ScanAlreadyAdded", orderId].Value, "dup");
        }
        else
        {
            PushFeed(Localizer["Home_ScanAdded", orderId].Value, "ok");
            await Haptic();
        }

        StateHasChanged();
    });

    private void PushFeed(string text, string kind)
    {
        scanFeed.Insert(0, new ScanFeedItem(text, kind));
        if (scanFeed.Count > ScanFeedLimit)
            scanFeed.RemoveRange(ScanFeedLimit, scanFeed.Count - ScanFeedLimit);
    }

    // Shape returned by runnerTicketScanner.start (camelCase JSON → these properties).
    public class ScanStartResult
    {
        public bool Supported { get; set; }
        public bool Started { get; set; }
        public string? Error { get; set; }
    }

    private async Task CollectSelected()
    {
        if (selected.Count == 0 || !Outbox.IsOnline) return;

        // The sweep is over once they commit — free the camera rather than leaving it running
        // through the walk to the stands.
        await StopScannerAsync();
        scanFeed.Clear();

        await Haptic();
        collecting = true;
        message = null;
        var ids = selected.ToList();
        var result = await Api.ClaimBatchAsync(ids);
        collecting = false;

        if (result is null)
        {
            message = Localizer["Home_CollectError"];
            StateHasChanged();
            return;
        }

        // Clean sweep — everything we asked for is ours. Go straight to the delivery list.
        if (result.Claimed.Count > 0 && result.Taken.Count == 0 && result.NotFound.Count == 0)
        {
            selected.Clear();
            Nav.NavigateTo("my-deliveries");
            return;
        }

        // Nothing left to take: another runner beat us to the whole selection.
        if (result.Claimed.Count == 0)
        {
            message = Localizer["Home_AllTaken"];
        }
        else
        {
            // Partial: keep the runner on the pool so they see what happened before moving on.
            message = Localizer["Home_PartialClaim", result.Claimed.Count, result.Taken.Count + result.NotFound.Count];
        }

        selected.Clear();
        await Load();
    }

    private async Task Haptic()
    {
        try { await JS.InvokeVoidAsync("runnerHaptic", 15); } catch { /* JS unavailable — ignore */ }
    }

    public async ValueTask DisposeAsync()
    {
        timer?.Dispose();
        Outbox.OnChange -= OnConnectivityChanged;
        Live.Changed -= OnLiveChanged;

        // Navigating away with the camera still held would leave the phone's capture indicator lit
        // and the device locked for the /scan page.
        try { await JS.InvokeVoidAsync("runnerTicketScanner.stop"); }
        catch (Exception ex) { Console.WriteLine($"Scanner disposal stop failed: {ex.Message}"); }
        selfRef?.Dispose();
    }
}
