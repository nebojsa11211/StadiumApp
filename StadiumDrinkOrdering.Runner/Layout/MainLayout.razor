@inherits LayoutComponentBase
@layout MobileShell
@implements IDisposable
@inject RunnerAuthService Auth
@inject OutboxService Outbox
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> Localizer

<div class="runner-shell" id="runner-main-layout-shell">
    <header class="runner-appbar" id="runner-main-layout-header">
        <StadiumDrinkOrdering.UI.Components.BrandWordmark Id="runner-main-layout-brand" Class="runner-brand" Size="21" Chip="true" Sub="@Localizer["Layout_Brand"]" />
        <div class="runner-appbar-right" id="runner-main-layout-appbar-right">
            <span class="runner-appbar-status" aria-live="polite">
                @if (!Outbox.IsOnline)
                {
                    <span class="runner-chip runner-chip-offline" id="runner-offline-chip">⚠ @Localizer["Layout_Offline"]</span>
                }
                @if (Outbox.Pending.Count > 0)
                {
                    <span class="runner-chip runner-chip-sync" id="runner-sync-chip">⏳ @Outbox.Pending.Count</span>
                }
            </span>
            <LanguageSwitcher />
            @if (Auth.IsAuthenticated)
            {
                <button class="runner-logout" @onclick="Logout" id="runner-logout">@Localizer["Layout_SignOut"]</button>
            }
        </div>
    </header>
    @if (Auth.IsAuthenticated)
    {
        @* Own slim row: the email no longer competes with brand/lang/sign-out for width on a phone. *@
        <div class="runner-userbar" id="runner-main-layout-userbar">
            <span class="runner-user-avatar" aria-hidden="true">@UserInitial</span>
            <span class="runner-user" id="runner-main-layout-user" title="@Auth.Email">@Auth.Email</span>
        </div>
    }

    <main class="runner-content" id="runner-main-layout-content">
        @Body
    </main>

    @if (Auth.IsAllowed)
    {
        <nav class="runner-tabbar" id="runner-main-layout-nav">
            <NavLink class="runner-tab" href="" Match="NavLinkMatch.All">
                <svg class="runner-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1M9 2.8h6v2.6H9zM8.5 10h7M8.5 13.5h7M8.5 17h4.5"/></svg><span>@Localizer["Layout_TabPool"]</span>
            </NavLink>
            <NavLink class="runner-tab" href="my-deliveries">
                <svg class="runner-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 17.5h6M14 17.5V6.5a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v11h-1.5M14 9H9.5L6 12.5v5h1"/><circle cx="8.5" cy="17.5" r="1.8"/><circle cx="18" cy="17.5" r="1.8"/><path d="M6 12.5h8"/></svg><span>@Localizer["Layout_TabMyDeliveries"]</span>
            </NavLink>
            <NavLink class="runner-tab" href="scan">
                <svg class="runner-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18v3a2.5 2.5 0 0 0 0 5v3H3v-3a2.5 2.5 0 0 0 0-5z"/><path d="M8 9.5v5M10.5 9.5v5M13 9.5v5M15.5 9.5v5"/></svg><span>@Localizer["Layout_TabScan"]</span>
            </NavLink>
        </nav>
    }
</div>

@code {
    protected override void OnInitialized() => Outbox.OnChange += OnOutboxChanged;

    private void OnOutboxChanged() => InvokeAsync(StateHasChanged);

    private string UserInitial =>
        string.IsNullOrEmpty(Auth.Email) ? "?" : char.ToUpperInvariant(Auth.Email[0]).ToString();

    private async Task Logout()
    {
        await Auth.ClearAsync();
        Nav.NavigateTo("login");
    }

    public void Dispose() => Outbox.OnChange -= OnOutboxChanged;
}
