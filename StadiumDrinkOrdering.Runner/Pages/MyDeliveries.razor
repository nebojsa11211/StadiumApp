@page "/my-deliveries"
@implements IDisposable
@inject RunnerApiService Api
@inject OutboxService Outbox
@inject RunnerLiveService Live
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> Localizer

<BrandPageTitle Station="@Localizer["Layout_Brand"]" Title="@Localizer["MyDeliveries_PageTitle"]" />

<div class="runner-page" id="runner-my-deliveries-page">
    <div class="runner-page-head" id="runner-my-deliveries-page-head">
        <h1 class="runner-page-title" id="runner-my-deliveries-title">@Localizer["MyDeliveries_Title"]</h1>
        <button class="runner-refresh" @onclick="Load" aria-label="@Localizer["MyDeliveries_Refresh"]" id="runner-mine-refresh"><RunnerIcon Name="refresh" Class="runner-icon" /></button>
    </div>

    @if (loading && mine is null)
    {
        <div class="runner-loading" id="runner-my-deliveries-loading"><div class="runner-cta-spinner" id="runner-my-deliveries-spinner"></div></div>
    }
    else if (active.Count == 0 && syncing.Count == 0)
    {
        <div class="runner-empty" id="runner-my-deliveries-empty">
            <div class="runner-empty-icon" id="runner-my-deliveries-empty-icon" aria-hidden="true"><RunnerIcon Name="check-circle" /></div>
            <div class="runner-empty-title">@Localizer["MyDeliveries_EmptyTitle"]</div>
            <div class="runner-empty-text" id="runner-my-deliveries-empty-text">@Localizer["MyDeliveries_EmptyMessage"] <a href="/" id="runner-my-deliveries-pool-link">@Localizer["MyDeliveries_PoolLink"]</a>.</div>
        </div>
    }
    else
    {
        @foreach (var o in active)
        {
            <div class="runner-card" id="runner-mine-card-@o.Id">
                @* Same language as the pool card: how long the fan has been waiting left, quiet ref right. *@
                <div class="runner-card-top" id="@($"runner-mine-card-{o.Id}-top")">
                    <AgePill CreatedAt="@o.CreatedAt" Label="@Localizer["MyDeliveries_Ordered"]" />
                    <span class="runner-card-meta"><span class="runner-order-id">#@o.Id</span></span>
                </div>
                <SeatHero SeatPath="@o.SeatPath" SeatNumber="@o.SeatNumber" Id="@($"runner-mine-card-{o.Id}-seat")" />
                <div class="runner-items" id="@($"runner-mine-card-{o.Id}-items")">
                    @foreach (var it in o.OrderItems)
                    {
                        <div id="@($"runner-mine-card-{o.Id}-item-{o.OrderItems.IndexOf(it)}")"><span class="runner-qty">@it.Quantity×</span> @it.DrinkName <svg class="runner-cup" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h10l-1.4 17H8.4z"/><path d="M7.4 8h9.2"/></svg></div>
                    }
                </div>
                <div class="runner-total" id="runner-mine-total-@o.Id">
                    <span class="runner-total-label">@Localizer["Home_TotalLabel"]</span>
                    <span class="runner-total-amount">€@o.TotalAmount.ToString("F2")</span>
                </div>
                @* One dominant "go" action; the exception path is a quiet neutral button underneath —
                   reachable, never competing (and not red: it's a normal outcome, not an error). *@
                <div class="runner-card-actions">
                    <button class="runner-cta" @onclick="() => Deliver(o.Id)" id="runner-mine-delivered-@o.Id">
                        <RunnerIcon Name="check" Class="runner-cta-icon" />
                        <span>@Localizer["MyDeliveries_MarkDeliveredButton"]</span>
                    </button>
                    <button class="runner-cta runner-cta-secondary" @onclick="() => OpenReasonSheet(o.Id)" id="runner-mine-cant-deliver-@o.Id">
                        <RunnerIcon Name="return" Class="runner-cta-icon" />
                        <span>@Localizer["MyDeliveries_CantDeliverButton"]</span>
                    </button>
                </div>
            </div>
        }

        @if (syncing.Count > 0)
        {
            <div class="runner-sync-head" id="runner-my-deliveries-sync-head"><span>@(syncing.Any(o => Outbox.IsPendingDeliveryFailed(o.Id)) ? Localizer["MyDeliveries_ReturnedSection"] : Localizer["MyDeliveries_DeliveredSection"])</span> <span class="runner-sync-count">@syncing.Count</span></div>
            @foreach (var o in syncing)
            {
                <div class="runner-card runner-card-pending" id="runner-mine-pending-@o.Id">
                    <div class="runner-card-top" id="@($"runner-mine-pending-{o.Id}-top")">
                        @if (Outbox.IsOnline)
                        {
                            <span class="runner-pending-badge runner-pending-badge-sync" id="@($"runner-mine-pending-{o.Id}-sync")"><RunnerIcon Name="clock" Class="runner-badge-ico" /> @Localizer["MyDeliveries_SyncingBadge"]</span>
                        }
                        else
                        {
                            <span class="runner-pending-badge runner-pending-badge-offline" id="@($"runner-mine-pending-{o.Id}-offline")"><RunnerIcon Name="alert" Class="runner-badge-ico" /> @Localizer["MyDeliveries_OfflineBadge"]</span>
                        }
                    </div>
                    <SeatHero SeatPath="@o.SeatPath" SeatNumber="@o.SeatNumber" Id="@($"runner-mine-pending-{o.Id}-seat")" />
                    <div class="runner-items" id="@($"runner-mine-pending-{o.Id}-items")">
                        <RunnerIcon Name="@(Outbox.IsPendingDeliveryFailed(o.Id) ? "return" : "check")" Class="runner-pending-ico" /><span class="runner-order-id">#@o.Id</span> · @(Outbox.IsPendingDeliveryFailed(o.Id) ? Localizer["MyDeliveries_MarkedReturned"] : Localizer["MyDeliveries_MarkedDelivered"])
                    </div>
                </div>
            }
        }
    }
</div>

@if (failingOrderId is not null)
{
    <div class="runner-sheet-backdrop" @onclick="CloseReasonSheet" id="runner-mine-reason-backdrop">
        <div class="runner-sheet" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="runner-mine-reason-title" id="runner-mine-reason-sheet">
            <div class="runner-sheet-grip" aria-hidden="true"></div>
            <div class="runner-sheet-title" id="runner-mine-reason-title">@Localizer["MyDeliveries_ReasonSheetTitle"]</div>
            <div class="runner-sheet-hint" id="runner-mine-reason-hint">@Localizer["MyDeliveries_ReasonSheetHint"]</div>
            <button class="runner-sheet-option" @onclick="() => PickReason(DeliveryFailureReason.CustomerNotAtSeat)" id="runner-mine-reason-not-at-seat"><span>@Localizer["MyDeliveries_ReasonNotAtSeat"]</span><RunnerIcon Name="chevron" Class="runner-sheet-chev" /></button>
            <button class="runner-sheet-option" @onclick="() => PickReason(DeliveryFailureReason.CustomerRefused)" id="runner-mine-reason-refused"><span>@Localizer["MyDeliveries_ReasonRefused"]</span><RunnerIcon Name="chevron" Class="runner-sheet-chev" /></button>
            <button class="runner-sheet-option" @onclick="() => PickReason(DeliveryFailureReason.WrongSeat)" id="runner-mine-reason-wrong-seat"><span>@Localizer["MyDeliveries_ReasonWrongSeat"]</span><RunnerIcon Name="chevron" Class="runner-sheet-chev" /></button>
            <button class="runner-sheet-option" @onclick="() => PickReason(DeliveryFailureReason.Other)" id="runner-mine-reason-other"><span>@Localizer["MyDeliveries_ReasonOther"]</span><RunnerIcon Name="chevron" Class="runner-sheet-chev" /></button>
            <button class="runner-sheet-cancel" @onclick="CloseReasonSheet" id="runner-mine-reason-cancel">@Localizer["MyDeliveries_ReasonCancel"]</button>
        </div>
    </div>
}

@code {
    private List<OrderDto>? mine;
    private List<OrderDto> active = new();
    private List<OrderDto> syncing = new();
    private bool loading;
    // The order whose "why couldn't you deliver?" reason sheet is open, or null when none is.
    private int? failingOrderId;

    private System.Threading.Timer? timer;
    private const int PollSeconds = 10;
    // Set when a refresh is requested mid-load, so exactly one more load follows (see Home).
    private bool reloadPending;

    protected override async Task OnInitializedAsync()
    {
        Outbox.OnChange += OnOutboxChanged;
        Live.Changed += OnLiveChanged;
        await Load();
        _ = Live.EnsureStartedAsync();
        // Backstop poll for when pushes can't arrive (offline / reconnecting): an order the bar
        // cancels or re-assigns still drops off this list.
        timer = new System.Threading.Timer(async _ => await InvokeAsync(Load), null,
            TimeSpan.FromSeconds(PollSeconds), TimeSpan.FromSeconds(PollSeconds));
    }

    private void OnLiveChanged() => _ = InvokeAsync(Load);

    private async Task Load()
    {
        if (loading)
        {
            reloadPending = true;
            return;
        }
        loading = true;
        // A failed fetch (offline) keeps the last good list on screen rather than blanking it.
        mine = await Api.GetMyDeliveriesAsync() ?? mine;
        Recompute();
        loading = false;
        StateHasChanged();

        if (reloadPending)
        {
            reloadPending = false;
            await Load();
        }
    }

    private void Recompute()
    {
        var outForDelivery = mine?.Where(o => o.Status == OrderStatus.OutForDelivery).ToList() ?? new();
        // An order whose delivery OR couldn't-deliver report is queued in the outbox is shown as
        // "syncing", not still-to-deliver — so tapping either action drops the card immediately.
        bool Queued(OrderDto o) => Outbox.IsPendingDeliver(o.Id) || Outbox.IsPendingDeliveryFailed(o.Id);
        active = outForDelivery.Where(o => !Queued(o)).ToList();
        syncing = outForDelivery.Where(Queued).ToList();
    }

    private void OpenReasonSheet(int orderId)
    {
        failingOrderId = orderId;
        _ = Haptic();
    }

    private void CloseReasonSheet() => failingOrderId = null;

    private async Task PickReason(DeliveryFailureReason reason)
    {
        var orderId = failingOrderId;
        failingOrderId = null;
        if (orderId is null) return;

        await Haptic();
        // Optimistic + offline-safe: queue the report, reflect immediately, let the outbox sync later.
        await Outbox.EnqueueDeliveryFailedAsync(orderId.Value, reason);
        Recompute();
        StateHasChanged();
    }

    private async Task Haptic()
    {
        try { await JS.InvokeVoidAsync("runnerHaptic", 15); } catch { /* JS unavailable — ignore */ }
    }

    private async Task Deliver(int orderId)
    {
        try { await JS.InvokeVoidAsync("runnerHaptic", 15); } catch { /* JS unavailable — ignore */ }
        // Optimistic + offline-safe: queue it, reflect immediately, let the outbox sync when possible.
        await Outbox.EnqueueDeliverAsync(orderId);
        Recompute();
        StateHasChanged();
    }

    private void OnOutboxChanged() => InvokeAsync(() =>
    {
        Recompute();     // instant: reflect new pending set against the data we already have
        StateHasChanged();
        _ = Load();      // background: reconcile against the server (drops synced-then-Delivered orders)
    });

    public void Dispose()
    {
        timer?.Dispose();
        Outbox.OnChange -= OnOutboxChanged;
        Live.Changed -= OnLiveChanged;
    }
}
