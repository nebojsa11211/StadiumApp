@using StadiumDrinkOrdering.Bar.Models
@inject IStringLocalizer<SharedResources> Localizer

<div id="bar-quickactions-card" class="card quick-actions-card">
    <div id="bar-quickactions-header" class="card-header">
        <h5 class="mb-0">@Title</h5>
    </div>
    <div id="bar-quickactions-body" class="card-body">
        @if (IsLoading)
        {
            <div id="bar-quickactions-loading-grid" class="d-grid gap-2">
                @for (int i = 0; i < 3; i++)
                {
                    <div id="bar-quickactions-skeleton-@i" class="skeleton-button"></div>
                }
            </div>
        }
        else if (Actions != null && Actions.Any())
        {
            <div id="bar-quickactions-actions-grid" class="qa-list">
                @foreach (var (action, actionIndex) in Actions.Select((a, i) => (a, i)))
                {
                    @if (!string.IsNullOrEmpty(action.Url))
                    {
                        <a href="@action.Url" class="btn qa-item @(action.IsDisabled ? "disabled" : "")" id="@($"bar-quickactions-action-link-{actionIndex}")">
                            @if (!string.IsNullOrEmpty(action.IconClass))
                            {
                                <span class="qa-icon"><span class="@action.IconClass" aria-hidden="true"></span></span>
                            }
                            <span class="qa-title">@action.Title</span>
                            @if (action.BadgeCount > 0)
                            {
                                <span class="qa-count">@action.BadgeCount</span>
                            }
                            <span class="qa-chevron oi oi-chevron-right" aria-hidden="true"></span>
                        </a>
                    }
                    else if (action.OnClick.HasDelegate)
                    {
                        <button class="btn qa-item @(action.IsDisabled ? "disabled" : "")"
                                @onclick="action.OnClick"
                                disabled="@action.IsDisabled"
                                id="@($"bar-quickactions-action-btn-{actionIndex}")">
                            @if (!string.IsNullOrEmpty(action.IconClass))
                            {
                                <span class="qa-icon"><span class="@action.IconClass" aria-hidden="true"></span></span>
                            }
                            <span class="qa-title">@action.Title</span>
                            @if (action.BadgeCount > 0)
                            {
                                <span class="qa-count">@action.BadgeCount</span>
                            }
                            <span class="qa-chevron oi oi-chevron-right" aria-hidden="true"></span>
                        </button>
                    }

                    @if (!string.IsNullOrEmpty(action.Description))
                    {
                        <small class="qa-desc">@action.Description</small>
                    }
                }
            </div>
        }
        else
        {
            <div id="bar-quickactions-empty-state" class="empty-state text-center text-muted py-3">
                <span class="oi oi-warning" style="font-size: 2rem;"></span>
                <p class="mt-2 mb-0">@Localizer["QuickActions_NoActionsAvailable"]</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Quick Actions";
    [Parameter] public IEnumerable<QuickAction>? Actions { get; set; }
    [Parameter] public bool IsLoading { get; set; }
}