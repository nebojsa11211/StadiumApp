@using StadiumDrinkOrdering.Shared.DTOs
@using StadiumDrinkOrdering.Shared.Models
@using StadiumDrinkOrdering.Customer.Services
@inject IStringLocalizer<SharedResources> Localizer
@inject IApiService Api

@* Bottom sheet for a drink: quantity + special instructions, then add. Visible whenever Drink != null. *@

<div id="customer-drink-sheet-scrim" class="scrim @(Drink != null ? "show" : "")" @onclick="OnClose"></div>
<div id="customer-drink-sheet-container" class="sheet @(Drink != null ? "show" : "")">
    @if (Drink != null)
    {
        <div id="customer-drink-sheet-grab" class="grab"></div>
        <div id="customer-drink-sheet-thumb" class="big-thumb @DrinkVisuals.Thumb(Drink.CategoryName)">
            @if (!string.IsNullOrWhiteSpace(Drink.ImageUrl))
            {
                <img id="customer-drink-sheet-thumb-img" src="@Drink.ImageUrl" alt="@Drink.Name" />
            }
            else
            {
                @DrinkVisuals.Emoji(Drink.CategoryIcon)
            }
        </div>
        <h3>@Drink.Name</h3>
        <div id="customer-drink-sheet-description" class="desc">@(string.IsNullOrWhiteSpace(Drink.Description) ? Localizer["DrinkSheet_DefaultDescription"] : Drink.Description)</div>

        <div id="customer-drink-sheet-stepper" class="stepper">
            <span class="lab">@Localizer["DrinkSheet_Quantity"]</span>
            <div id="customer-drink-sheet-control" class="ctrl">
                <button id="customer-drink-sheet-dec-btn" @onclick="Dec" aria-label="@Localizer["DrinkSheet_Decrease"]">−</button>
                <span class="q tnum">@_qty</span>
                <button id="customer-drink-sheet-inc-btn" @onclick="Inc" aria-label="@Localizer["DrinkSheet_Increase"]">+</button>
            </div>
        </div>

        <textarea id="customer-drink-sheet-note-input" class="note-in" rows="2" @bind="_note" placeholder="@Localizer["DrinkSheet_SpecialInstructions"]"></textarea>

        @* Reusable-cup choice — only shown when the venue has cups enabled with at least one usable mode. *@
        @if (CupSettings is { CupsEnabled: true } && (CupSettings.CupDepositModeEnabled || CupSettings.CupHonorModeEnabled || CupSettings.CupByocEnabled))
        {
            <div id="customer-drink-sheet-cup" style="margin:10px 0 2px;">
                <div style="font-size:.85rem;color:#666;margin-bottom:6px;">@Localizer["DrinkSheet_CupMode"]</div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <button type="button" id="customer-drink-sheet-cup-none" style="@CupBtnStyle(_cupMode == CupMode.None)" @onclick="() => SetMode(CupMode.None)">@Localizer["DrinkSheet_CupNone"]</button>
                    @if (CupSettings.CupDepositModeEnabled)
                    {
                        <button type="button" id="customer-drink-sheet-cup-deposit" style="@CupBtnStyle(_cupMode == CupMode.Deposit)" @onclick="() => SetMode(CupMode.Deposit)">@Localizer["DrinkSheet_CupDeposit"]</button>
                    }
                    @if (CupSettings.CupHonorModeEnabled)
                    {
                        <button type="button" id="customer-drink-sheet-cup-honor" style="@CupBtnStyle(_cupMode == CupMode.HonorSystem)" @onclick="() => SetMode(CupMode.HonorSystem)">@Localizer["DrinkSheet_CupHonor"]</button>
                    }
                    @if (CupSettings.CupByocEnabled)
                    {
                        <button type="button" id="customer-drink-sheet-cup-byoc" style="@CupBtnStyle(_cupMode == CupMode.ByocQr)" @onclick="() => SetMode(CupMode.ByocQr)">@Localizer["DrinkSheet_CupByoc"]</button>
                    }
                </div>
                @if (_cupMode == CupMode.Deposit)
                {
                    <div id="customer-drink-sheet-cup-hint" style="font-size:.8rem;color:#666;margin-top:6px;">
                        @Localizer["DrinkSheet_CupDepositHint", (CupSettings.CupDepositAmount * _qty).ToString("F2")]
                    </div>
                }
                else if (_cupMode == CupMode.HonorSystem)
                {
                    <div id="customer-drink-sheet-cup-hint" style="font-size:.8rem;color:#666;margin-top:6px;">@Localizer["DrinkSheet_CupHonorHint"]</div>
                }
                else if (_cupMode == CupMode.ByocQr)
                {
                    <div id="customer-drink-sheet-cup-byoc-block" style="margin-top:8px;">
                        <div style="display:flex;gap:8px;">
                            <input id="customer-drink-sheet-cup-token" class="note-in" style="flex:1;margin:0;" @bind="_cupToken"
                                   placeholder="@Localizer["DrinkSheet_CupByocPlaceholder"]" autocomplete="off" />
                            <button type="button" id="customer-drink-sheet-cup-check" style="@CupBtnStyle(false)" @onclick="ResolveCup"
                                    disabled="@(_resolvingCup || string.IsNullOrWhiteSpace(_cupToken))">@Localizer["DrinkSheet_CupByocCheck"]</button>
                        </div>
                        @if (_cupResolve is { } r)
                        {
                            <div id="customer-drink-sheet-cup-byoc-status" style="font-size:.8rem;margin-top:6px;color:@(r.Usable ? "#059669" : "#dc2626");">
                                @if (r.Usable)
                                {
                                    @Localizer["DrinkSheet_CupByocOk", r.Discount.ToString("F2")]
                                }
                                else
                                {
                                    @(r.Reason ?? Localizer["DrinkSheet_CupByocBad"])
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* What's left to spend after the cart already in play, so the fan sizes this drink against
           real money rather than discovering the shortfall on the CartBar afterwards. Null Available
           means no wallet (or it failed to load) — render nothing rather than a misleading €0.00. *@
        @if (Available is { } available)
        {
            var lineTotal = Drink.Price * _qty;
            var short_ = lineTotal - available;
            <div id="customer-drink-sheet-funds" class="funds @(short_ > 0 ? "short" : "")" role="status" aria-live="polite">
                <span id="customer-drink-sheet-funds-text" class="funds-t">
                    @(short_ > 0
                        ? Localizer["DrinkSheet_Short", short_.ToString("F2")]
                        : Localizer["DrinkSheet_Available", available.ToString("F2")])
                </span>
                @if (short_ > 0)
                {
                    <button id="customer-drink-sheet-topup-btn" class="funds-cta" @onclick="OnTopUp">@Localizer["CartBar_TopUp"] ›</button>
                }
            </div>
        }

        <button id="customer-drink-sheet-submit-btn" class="btn btn-primary" @onclick="Submit">@Localizer["DrinkSheet_AddToCart"] €@((Drink.Price * _qty).ToString("F2"))</button>
    }
</div>

@code {
    [Parameter] public DrinkDto? Drink { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<DrinkOrderRequest> OnAdd { get; set; }

    // Spendable balance minus whatever is already in the cart; null when there's no wallet or it
    // couldn't be loaded, in which case the affordability line is omitted entirely.
    [Parameter] public decimal? Available { get; set; }
    [Parameter] public EventCallback OnTopUp { get; set; }

    // Venue reusable-cup config; null/disabled means the cup chooser is not shown.
    [Parameter] public CupsSettingsDto? CupSettings { get; set; }

    private int _qty = 1;
    private string? _note;
    private CupMode _cupMode = CupMode.None;
    private string? _cupToken;
    private CupResolveDto? _cupResolve;
    private bool _resolvingCup;
    private int? _lastId;

    protected override void OnParametersSet()
    {
        // Reset when a different drink opens; forget when closed.
        if (Drink != null && Drink.Id != _lastId)
        {
            _qty = 1;
            _note = null;
            _cupMode = CupMode.None;
            _cupToken = null;
            _cupResolve = null;
            _lastId = Drink.Id;
        }
        else if (Drink == null)
        {
            _lastId = null;
        }
    }

    private void Inc() => _qty = Math.Min(20, _qty + 1);
    private void Dec() => _qty = Math.Max(1, _qty - 1);

    private void SetMode(CupMode mode)
    {
        _cupMode = mode;
        if (mode != CupMode.ByocQr) { _cupToken = null; _cupResolve = null; }
    }

    private async Task ResolveCup()
    {
        if (string.IsNullOrWhiteSpace(_cupToken)) return;
        _resolvingCup = true;
        try { _cupResolve = await Api.ResolveCupAsync(_cupToken.Trim()); }
        finally { _resolvingCup = false; }
    }

    // Selected vs unselected cup-mode pill (inline so the sheet needs no extra CSS).
    private static string CupBtnStyle(bool selected) =>
        $"padding:8px 12px;border-radius:10px;font-size:.85rem;cursor:pointer;border:1px solid {(selected ? "#2563eb" : "#ccc")};" +
        $"background:{(selected ? "#2563eb" : "#fff")};color:{(selected ? "#fff" : "#333")};";

    private async Task Submit()
    {
        if (Drink != null)
            await OnAdd.InvokeAsync(new DrinkOrderRequest(Drink.Id, _qty, _note, _cupMode,
                _cupMode == CupMode.ByocQr ? _cupToken?.Trim() : null));
    }
}
