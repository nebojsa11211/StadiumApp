@using StadiumDrinkOrdering.Customer.Services
@using StadiumDrinkOrdering.Customer.Components
@inject ICustomerAuthStateService AuthStateService
@inject IStringLocalizer<SharedResources> Localizer

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthenticationInitializer>
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MobileShell)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </AuthenticationInitializer>
    </Found>
    <NotFound>
        <PageTitle>@Localizer["NotFound_PageTitle"]</PageTitle>
        <LayoutView Layout="@typeof(MobileShell)">
            <ScreenHeader Title="@Localizer["NotFound_HeaderTitle"]" BackHref="/" />
            <div class="gate" role="alert">
                <div class="gate-icon">🔍</div>
                <h2>@Localizer["NotFound_Heading"]</h2>
                <p>@Localizer["NotFound_Text"]</p>
                <div class="gate-actions">
                    <a class="btn btn-primary" href="/">@Localizer["NotFound_HomeButton"]</a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthStateService.InitializeAsync();
    }
}
